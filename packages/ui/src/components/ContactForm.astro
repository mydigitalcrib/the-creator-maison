---
/**
 * Shared "send a brief" form for all 3 sites.
 *
 * - Leave `action` empty while there's no form service: submitting then just
 *   shows a friendly placeholder message (nothing is sent anywhere).
 * - Set `action` to the form service URL (e.g. Formspree) before launch.
 *
 * Theme with the site's --mfm-* tokens, or style `.mfm-form` from the site.
 */
interface Props {
  action?: string;
  class?: string;
}
const { action, class: className } = Astro.props;
const id = 'brief';

const deliverables = [
  'Short-form video',
  'Long-form video',
  'Photos',
  'Usage rights / paid ads',
  'Something else',
];
const timelines = ['As soon as possible (under 2 weeks)', '2–4 weeks', '1–3 months', 'Flexible'];
const budgets = ['Under $500', '$500 – $1,500', '$1,500 – $5,000', '$5,000+', 'Not sure yet'];
---

<form
  class:list={['mfm-form', className]}
  method="post"
  action={action || undefined}
  data-placeholder={action ? undefined : ''}
  aria-describedby={`${id}-note`}
>
  <p id={`${id}-note`} class="mfm-form__note">Fields marked * are required.</p>

  <div class="mfm-form__row">
    <div class="mfm-form__field">
      <label for={`${id}-name`}>Your name *</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="mfm-form__field">
      <label for={`${id}-email`}>Email *</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="mfm-form__field">
    <label for={`${id}-brand`}>Brand or company *</label>
    <input id={`${id}-brand`} name="brand" type="text" autocomplete="organization" required />
  </div>

  <fieldset class="mfm-form__field mfm-form__choices">
    <legend>What do you need?</legend>
    {
      deliverables.map((d, i) => (
        <label class="mfm-form__check">
          <input type="checkbox" name="deliverables" value={d} id={`${id}-deliverable-${i}`} />
          <span>{d}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="mfm-form__row">
    <div class="mfm-form__field">
      <label for={`${id}-timeline`}>Timeline</label>
      <select id={`${id}-timeline`} name="timeline">
        <option value="">Choose one</option>
        {timelines.map((t) => <option>{t}</option>)}
      </select>
    </div>
    <div class="mfm-form__field">
      <label for={`${id}-budget`}>Budget</label>
      <select id={`${id}-budget`} name="budget">
        <option value="">Choose one</option>
        {budgets.map((b) => <option>{b}</option>)}
      </select>
    </div>
  </div>

  <div class="mfm-form__field">
    <label for={`${id}-message`}>Tell me about the project *</label>
    <textarea id={`${id}-message`} name="message" rows="5" required></textarea>
  </div>

  <!-- Spam trap: real people never see or fill this. -->
  <div hidden>
    <label>Leave this empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <button type="submit" class="mfm-form__submit">Send brief</button>
  <p class="mfm-form__status" role="status" aria-live="polite"></p>
</form>

<style>
  .mfm-form {
    display: grid;
    gap: 1.25rem;
    max-width: 42rem;
  }

  .mfm-form__row {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .mfm-form__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .mfm-form__note,
  label,
  legend {
    font-family: var(--mfm-font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: var(--mfm-tap, 2.75rem);
    padding: 0.6rem 0.75rem;
    border: 1.5px solid var(--mfm-text);
    border-radius: var(--mfm-radius);
    background: var(--mfm-bg);
  }

  textarea {
    resize: vertical;
  }

  .mfm-form__choices {
    border: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mfm-form__choices legend {
    margin-bottom: 0.4rem;
  }

  .mfm-form__check {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: var(--mfm-tap, 2.75rem);
    padding: 0 0.9rem;
    border: 1.5px solid var(--mfm-text);
    border-radius: 999px;
    cursor: pointer;
  }

  .mfm-form__check:has(input:checked) {
    background: var(--mfm-accent);
    border-color: var(--mfm-accent);
    color: var(--mfm-accent-contrast);
  }

  .mfm-form__check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--mfm-text);
  }

  .mfm-form__submit {
    justify-self: start;
    min-height: var(--mfm-tap, 2.75rem);
    padding: 0 1.5rem;
    border: 0;
    border-radius: 999px;
    background: var(--mfm-accent);
    color: var(--mfm-accent-contrast);
    font-weight: 600;
  }

  .mfm-form__status:empty {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form.mfm-form[data-placeholder]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.mfm-form__status');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (status) {
        status.textContent =
          "Thanks! This form isn't connected yet (placeholder), so nothing was sent.";
      }
    });
  });
</script>
