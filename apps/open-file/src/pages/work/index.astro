---
/**
 * Site A · All work — the index: every category (h2) and its videos as rows.
 * Hover a row to see the video next to the cursor. Also the plain list (#list).
 */
import { getCollection } from 'astro:content';
import { categoryHref, FORMAT_LABELS, formatCompact, loadSite, videoHref } from '@mfm/content';
import Site from '../../layouts/Site.astro';

const { categories, videos, videosByCategory } = await loadSite(getCollection);
---

<Site title="All work" description={`All ${videos.length} videos, by category.`}>
  <header class="page-head wrap">
    <p class="label label--muted">Index — {categories.length} categories · {videos.length} videos</p>
    <h1 class="display page-title" data-reveal>All work</h1>
  </header>

  <div class="index wrap" id="list">
    {
      categories.map((c, i) => (
        <section class="wi" aria-labelledby={`cat-${c.id}`} data-reveal>
          <div class="wi-head">
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h2 id={`cat-${c.id}`} class="display wi-title">
              <a href={categoryHref(c.id)}>{c.data.title}</a>
            </h2>
            <p class="label label--muted wi-blurb">{c.data.blurb}</p>
          </div>
          <ol class="wi-list">
            {(videosByCategory.get(c.id) ?? []).map((v) => (
              <li>
                <a class="wi-row" href={videoHref(v)} data-preview={v.data.src}>
                  <span class="wi-name">{v.data.title}</span>
                  <span class="label label--muted">{v.data.brand}</span>
                  <span class="label label--muted wi-format">{FORMAT_LABELS[v.data.format]}</span>
                  <span class="label">{v.data.results?.views ? `${formatCompact(v.data.results.views)} views` : ''}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Site>

<style>
  .index {
    padding-block-end: clamp(4rem, 9vw, 8rem);
  }

  .wi {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1.2rem var(--gutter);
    padding-block: 1.6rem 2.4rem;
    border-top: 1px solid var(--ink);
  }

  .wi-head {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .wi-title {
    font-size: clamp(2.8rem, 6.5vw, 6.5rem);
  }

  .wi-title a {
    text-decoration: none;
  }

  .wi-title a:hover {
    color: var(--velvet);
  }

  .wi-blurb {
    max-width: 26rem;
  }

  .wi-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wi-row {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 0.8fr) 6rem;
    align-items: baseline;
    gap: 1rem;
    min-height: 44px;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition:
      color var(--t-fast) var(--ease-out),
      padding var(--t-base) var(--ease-out);
  }

  .wi-row > :last-child {
    text-align: right;
  }

  .wi-name {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .wi-row:hover {
    padding-inline-start: 0.8rem;
    color: var(--velvet);
  }

  @media (max-width: 47.99rem) {
    .wi {
      grid-template-columns: 1fr;
    }

    .wi-row {
      grid-template-columns: 1fr auto;
    }

    .wi-row > :nth-child(2),
    .wi-format {
      display: none;
    }
  }
</style>
