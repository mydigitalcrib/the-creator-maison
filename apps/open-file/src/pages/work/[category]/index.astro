---
/** Site A · one category: a big title, then its videos with product-style tags. */
import { getCollection } from 'astro:content';
import { categoryHref, loadSite, type Category } from '@mfm/content';
import VideoCard from '../../../components/VideoCard.astro';
import Site from '../../../layouts/Site.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((c) => ({ params: { category: c.id } }));
}

const { categories, videosByCategory } = await loadSite(getCollection);
const index = categories.findIndex((c) => c.id === Astro.params.category);
const category = categories[index] as Category;
const items = videosByCategory.get(category.id) ?? [];
const aspect = category.data.length === 'long' ? 'landscape' : 'portrait';
const before = categories[index - 1];
const after = categories[index + 1];
---

<Site title={category.data.title} description={category.data.blurb}>
  <header class="page-head wrap">
    <p class="label"><a class="link" href="/work/">All work</a> / {String(index + 1).padStart(2, '0')}</p>
    <h1 class="display page-title" data-reveal>{category.data.title}</h1>
    <p class="lead">{category.data.blurb}</p>
  </header>

  <ul class:list={['videos wrap', `videos--${aspect}`]}>
    {
      items.map((v, i) => (
        <li data-reveal style={`--i:${i}`}>
          <VideoCard video={v} aspect={aspect} side={i % 2 ? 'right' : 'left'} />
        </li>
      ))
    }
  </ul>

  <nav class="pager label wrap" aria-label="Other categories">
    {before ? <a href={categoryHref(before.id)}>← {before.data.title}</a> : <a href="/work/">← All work</a>}
    {after ? <a href={categoryHref(after.id)}>{after.data.title} →</a> : <a href="/proof/">Proof →</a>}
  </nav>
</Site>

<style>
  .videos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding-block: 1rem clamp(4rem, 8vw, 7rem);
    list-style: none;
  }

  .videos--portrait > li:nth-child(2) {
    margin-block-start: 5rem;
  }

  .videos--landscape {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pager {
    margin-inline: var(--gutter);
    padding-inline: 0;
  }

  @media (max-width: 47.99rem) {
    .videos,
    .videos--landscape {
      grid-template-columns: 1fr;
      padding-inline: 10%;
    }

    .videos--portrait > li:nth-child(2) {
      margin-block-start: 0;
    }
  }
</style>
