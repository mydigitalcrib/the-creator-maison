---
/** Site A · one video, lookbook style: the video on one side, the specs and the brief on the other. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import {
  categoryHref,
  FORMAT_LABELS,
  formatCompact,
  formatDuration,
  loadSite,
  PLATFORM_LABELS,
  seedFor,
  videoHref,
  videoSlug,
} from '@mfm/content';
import VideoPlayer from '@mfm/ui/components/VideoPlayer.astro';
import Site from '../../../layouts/Site.astro';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  return videos.map((entry) => ({
    params: { category: entry.data.category, video: videoSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'videos'> };
const { Content } = await render(entry);
const { categories, videosByCategory } = await loadSite(getCollection);

const category = categories.find((c) => c.id === entry.data.category)!;
const ci = categories.indexOf(category);
const siblings = videosByCategory.get(category.id) ?? [];
const index = siblings.findIndex((s) => s.id === entry.id);
const before = siblings[index - 1];
const after = siblings[index + 1];
const nextCategory = categories[ci + 1];

const prev = before
  ? { href: videoHref(before), label: before.data.title }
  : { href: categoryHref(category.id), label: category.data.title };
const next = after
  ? { href: videoHref(after), label: after.data.title }
  : nextCategory
    ? { href: categoryHref(nextCategory.id), label: nextCategory.data.title }
    : { href: '/proof/', label: 'Proof' };

const v = entry.data;
const aspect = category.data.length === 'long' ? 'landscape' : 'portrait';
const specs = [
  ['Brand', v.brand],
  ['Category', category.data.title],
  ['Format', FORMAT_LABELS[v.format]],
  ['Platform', PLATFORM_LABELS[v.platform]],
  ['Length', v.duration ? formatDuration(v.duration) : undefined],
  ['Views', v.results?.views !== undefined ? formatCompact(v.results.views) : undefined],
  ['Likes', v.results?.likes !== undefined ? formatCompact(v.results.likes) : undefined],
  ['Shares', v.results?.shares !== undefined ? formatCompact(v.results.shares) : undefined],
  ['Saves', v.results?.saves !== undefined ? formatCompact(v.results.saves) : undefined],
].filter(([, value]) => value);
---

<Site title={v.title} description={`${v.title}, a video for ${v.brand}.`}>
  <article class:list={['vp wrap', `vp--${aspect}`]}>
    <div class="vp-media">
      <VideoPlayer title={`${v.title}, for ${v.brand}`} src={v.src} aspect={aspect} seed={seedFor(entry.id)} />
    </div>
    <div class="vp-info">
      <p class="label">
        <a class="link" href="/work/">All work</a> / <a class="link" href={categoryHref(category.id)}>{category.data.title}</a>
      </p>
      <h1 class="display vp-title" data-reveal>{v.title}</h1>
      <dl class="spec label" data-reveal style="--i:1">
        {
          specs.map(([k, value]) => (
            <div>
              <dt>{k}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <h2 class="label label--muted">The brief</h2>
      <div class="lead vp-brief"><Content /></div>
      <nav class="pager label" aria-label="More videos">
        <a href={prev.href} rel="prev">← {prev.label}</a>
        <a href={next.href} rel="next">{next.label} →</a>
      </nav>
    </div>
  </article>
</Site>

<style>
  .vp {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 7rem);
    padding-block: clamp(6rem, 12vw, 8rem) clamp(4rem, 8vw, 6rem);
  }

  .vp--landscape {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }

  .vp-media {
    position: sticky;
    inset-block-start: 5rem;
    max-width: 30rem;
  }

  .vp--landscape .vp-media {
    max-width: none;
  }

  .vp-info {
    display: grid;
    gap: 1.6rem;
  }

  .vp-title {
    font-size: clamp(3rem, 6.5vw, 6.8rem);
  }

  .vp-brief :global(p) {
    margin: 0 0 0.8em;
  }

  .pager {
    margin-block-start: 1rem;
  }

  @media (max-width: 47.99rem) {
    .vp,
    .vp--landscape {
      grid-template-columns: 1fr;
    }

    .vp-media {
      position: static;
      max-width: 22rem;
    }
  }
</style>
