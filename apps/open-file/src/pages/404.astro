---
/** Site A · 404 */
import Site from '../layouts/Site.astro';
---

<Site title="Page not found" description="This page doesn't exist.">
  <section class="lost wrap">
    <p class="display lost-code" aria-hidden="true">404</p>
    <h1 class="label lost-title">Page not found</h1>
    <p class="lead">This page isn&apos;t part of the drop. Try one of these:</p>
    <ul class="label links">
      <li><a class="link" href="/">Home</a></li>
      <li><a class="link" href="/work/">All work</a></li>
      <li><a class="link" href="/contact/">Contact</a></li>
    </ul>
  </section>
</Site>

<style>
  .lost {
    display: grid;
    gap: 1.4rem;
    padding-block: clamp(7rem, 14vw, 10rem) clamp(4rem, 8vw, 7rem);
  }

  .lost-code {
    font-size: clamp(8rem, 34vw, 30rem);
  }

  .lost-title {
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    gap: 0 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
