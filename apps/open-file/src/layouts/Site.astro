---
/**
 * Site A · Open File — page shell (Phase 1: structure + tokens only).
 * The tab-stack navigation and folder transitions arrive in Phase 2.
 */
import '@mfm/ui/styles/base.css';
import '../styles/tokens.css';

import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import { loadSite } from '@mfm/content';
import BaseHead from '@mfm/ui/components/BaseHead.astro';
import SkipLink from '@mfm/ui/components/SkipLink.astro';

interface Props {
  title: string;
  description?: string;
}

const { profile } = await loadSite(getCollection);
const { title, description = profile.tagline } = Astro.props;

const SITE = { letter: 'A', name: 'Open File' };
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/proof/', label: 'Proof' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} siteName={profile.name} themeColor="#f5efe7" />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-dm-mono" preload={[{ weight: "400" }]} />
  </head>
  <body>
    <SkipLink />
    <header class="site-header">
      <a class="brand" href="/">{profile.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <ul class="socials">
        {profile.socials.map((s) => <li><a href={s.url} rel="me noopener">{s.label}</a></li>)}
      </ul>
      <p class="preview-tag">Preview · {SITE.letter} · {SITE.name}</p>
    </footer>
  </body>
</html>

<style is:global>
  .site-header,
  .site-footer,
  main {
    width: min(100% - 2 * var(--mfm-gutter), var(--mfm-max));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--mfm-border);
  }

  .brand {
    font-family: var(--mfm-font-display);
    font-size: 1.75rem;
    font-style: italic;
    text-decoration: none;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .site-header nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mfm-tap);
    font-family: var(--mfm-font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header nav a[aria-current='page'] {
    color: var(--mfm-accent);
    text-decoration: underline;
  }

  main {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  main:focus {
    outline: none;
  }

  h1,
  h2 {
    font-family: var(--mfm-font-display);
    font-weight: 400;
  }

  h1 {
    font-size: clamp(3rem, 12vw, 9rem);
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h1 em,
  h2 em {
    color: var(--mfm-accent);
  }

  .eyebrow,
  .meta {
    font-family: var(--mfm-font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mfm-muted);
  }

  .site-footer {
    display: grid;
    gap: 1rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--mfm-border);
    font-family: var(--mfm-font-mono);
    font-size: 0.85rem;
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mfm-tap);
  }

  .preview-tag {
    color: var(--mfm-muted);
  }
</style>
