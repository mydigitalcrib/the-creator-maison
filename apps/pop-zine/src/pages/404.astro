---
import Site from '../layouts/Site.astro';
---

<Site title="Page not found" description="This page doesn't exist.">
  <p class="eyebrow">Error 404</p>
  <h1>Page not found</h1>
  <p class="intro">This page isn&apos;t here. Try one of these instead:</p>
  <ul class="links">
    <li><a href="/">Home</a></li>
    <li><a href="/work/">All work</a></li>
    <li><a href="/contact/">Contact</a></li>
  </ul>
</Site>

<style>
  h1 {
    margin-block: 0.5rem 1.5rem;
  }

  .intro {
    font-size: 1.15rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    margin-block-start: 1rem;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mfm-tap);
    font-family: var(--mfm-font-mono);
  }
</style>
