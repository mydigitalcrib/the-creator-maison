---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import {
  categoryHref,
  FORMAT_LABELS,
  formatCompact,
  formatDuration,
  loadSite,
  PLATFORM_LABELS,
  videoHref,
  videoSlug,
} from '@mfm/content';
import VideoPlayer from '@mfm/ui/components/VideoPlayer.astro';
import Site from '../../../layouts/Site.astro';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  return videos.map((entry) => ({
    params: { category: entry.data.category, video: videoSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'videos'> };
const { Content } = await render(entry);
const { categories, videosByCategory } = await loadSite(getCollection);

const category = categories.find((c) => c.id === entry.data.category)!;
const siblings = videosByCategory.get(category.id) ?? [];
const index = siblings.findIndex((s) => s.id === entry.id);
const prev = siblings[index - 1];
const next = siblings[index + 1];
const aspect = category.data.length === 'long' ? 'landscape' : 'portrait';
const v = entry.data;

const results = [
  ['Views', v.results?.views],
  ['Likes', v.results?.likes],
  ['Shares', v.results?.shares],
  ['Saves', v.results?.saves],
].filter((r): r is [string, number] => typeof r[1] === 'number');
---

<Site title={`${v.title} · ${v.brand}`} description={`${FORMAT_LABELS[v.format]} video for ${v.brand}.`}>
  <p class="eyebrow">
    <a href="/work/">All work</a> / <a href={categoryHref(category.id)}>{category.data.title}</a>
  </p>
  <h1>{v.title}</h1>

  <div class:list={['layout', `layout--${aspect}`]}>
    <VideoPlayer
      title={`${v.title}, for ${v.brand}`}
      src={v.src}
      poster={v.poster?.src}
      captions={v.captions}
      aspect={aspect}
    />

    <div class="details">
      <dl class="facts">
        <div><dt>Brand</dt><dd>{v.brand}</dd></div>
        <div><dt>Format</dt><dd>{FORMAT_LABELS[v.format]}</dd></div>
        <div><dt>Platform</dt><dd>{PLATFORM_LABELS[v.platform]}</dd></div>
        {v.duration && <div><dt>Length</dt><dd>{formatDuration(v.duration)}</dd></div>}
      </dl>

      {
        results.length > 0 && (
          <section aria-labelledby="results-title">
            <h2 id="results-title">Results</h2>
            <dl class="results">
              {results.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{formatCompact(value)}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <section aria-labelledby="brief-title" class="brief">
        <h2 id="brief-title">The brief</h2>
        <Content />
      </section>
    </div>
  </div>

  <nav class="pager" aria-label={`More ${category.data.title} videos`}>
    {prev ? <a href={videoHref(prev)} rel="prev">← {prev.data.title}</a> : <span />}
    {next && <a href={videoHref(next)} rel="next">{next.data.title} →</a>}
  </nav>
</Site>

<style>
  .eyebrow a {
    color: inherit;
  }

  h1 {
    margin-block: 0.5rem 2rem;
    font-size: clamp(2.5rem, 8vw, 6rem);
  }

  .layout {
    display: grid;
    gap: 2.5rem;
  }

  .layout--portrait {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .layout--portrait :global(.mfm-video) {
    max-width: 26rem;
  }

  .details {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  dl {
    display: grid;
    gap: 0.75rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
  }

  dt {
    font-family: var(--mfm-font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mfm-muted);
  }

  dd {
    font-size: 1.15rem;
  }

  .results dd {
    font-family: var(--mfm-font-display);
    font-size: 2.5rem;
    line-height: 1;
  }

  .details h2 {
    font-size: 1.75rem;
    margin-block-end: 0.75rem;
  }

  .brief {
    max-width: 52ch;
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid var(--mfm-border);
  }

  .pager a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mfm-tap);
    font-family: var(--mfm-font-mono);
  }
</style>
