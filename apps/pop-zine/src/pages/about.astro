---
import { getCollection } from 'astro:content';
import { loadSite } from '@mfm/content';
import Site from '../layouts/Site.astro';

const { profile } = await loadSite(getCollection);
---

<Site title="About" description={`About ${profile.name}: ${profile.role}.`}>
  <p class="eyebrow">{profile.role} · {profile.location}</p>
  <h1>About</h1>
  <div class="bio">
    {profile.bio.map((p) => <p>{p}</p>)}
  </div>
  <h2>Find me</h2>
  <ul class="socials">
    {profile.socials.map((s) => <li><a href={s.url} rel="me noopener">{s.label}</a></li>)}
  </ul>
</Site>

<style>
  h1 {
    margin-block: 0.5rem 2rem;
  }

  .bio {
    display: grid;
    gap: 1rem;
    max-width: 52ch;
    font-size: 1.2rem;
    margin-block-end: 3rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    margin-block-start: 1rem;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mfm-tap);
    font-family: var(--mfm-font-mono);
  }
</style>
